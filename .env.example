# Backend Flask
SECRET_KEY=CAMBIA_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
ADMIN_USER=admin
ADMIN_PASSWORD=CAMBIA_ESTA_PASSWORD
DEFAULT_USER_PASSWORD=CAMBIA_PASSWORD_INICIAL_USUARIOS
TOKEN_HOURS=8

# Local (si no defines DATABASE_URL, usa SQLite automáticamente)
# DATABASE_URL=sqlite:///usuarios.db

# Azure Database for MySQL (ejemplo)
# DATABASE_URL=mysql+pymysql://USUARIO:PASSWORD@SERVIDOR.mysql.database.azure.com:3306/tarjetas_refax?ssl_ca=/home/site/wwwroot/certs/DigiCertGlobalRootG2.crt.pem

# URL pública del backend en Azure
BACKEND_PUBLIC_URL=https://TU-APP.azurewebsites.net

# URL exacta de GitHub Pages, sin / al final
FRONTEND_URL=https://TU-USUARIO.github.io/TarjetasRefax

# Orígenes permitidos. Puedes separar varios con coma.
CORS_ORIGINS=https://TU-USUARIO.github.io
